{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/eke/review_certificate.schema.json",
  "title": "EKE Review Certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificate_id",
    "review_id",
    "status",
    "issuance",
    "certificate_type",
    "review_outcome",
    "classification"
  ],
  "properties": {
    "certificate_id": {
      "type": "string",
      "pattern": "^EKE-CERT-[0-9]{4}-[0-9]{3}$"
    },
    "review_id": {
      "type": "string",
      "pattern": "^EKE-IR-[0-9]{4}-[0-9]{3}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "REVOKED",
        "CHALLENGED"
      ]
    },
    "issuance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "issuer_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification_state": {
      "type": "string",
      "enum": [
        "DESIGNED",
        "IMPLEMENTED",
        "TESTED",
        "VERIFIED",
        "INDEPENDENTLY_REPRODUCED"
      ]
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_reference",
        "attestation_statement",
        "attestation_timestamp"
      ],
      "properties": {
        "reviewer_reference": {
          "type": "string",
          "minLength": 1
        },
        "attestation_statement": {
          "type": "string",
          "minLength": 1
        },
        "attestation_timestamp": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ai_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used"
      ],
      "properties": {
        "used": {
          "type": "boolean"
        },
        "system_provider": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "decision_authority": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hash": {
          "type": "string",
          "minLength": 1
        },
        "manifest_reference": {
          "type": "string",
          "minLength": 1
        },
        "cryptographic_root": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "challenge_reference": {
      "type": "string",
      "minLength": 1
    },
    "certificate_type": {
      "type": "string",
      "enum": [
        "VERIFIABLE",
        "FAILED",
        "AI_ASSISTED"
      ]
    },
    "review_outcome": {
      "type": "string",
      "enum": [
        "SUCCESSFUL_REVIEW",
        "REVIEW_FAILED",
        "AI_ASSISTED_HUMAN_VERIFIED"
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "NON_CONFORMANT",
        "PARTIALLY_VERIFIED"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "VERY_HIGH"
      ]
    },
    "babt_reference": {
      "type": "string",
      "minLength": 1
    },
    "registry_reference": {
      "type": "string",
      "pattern": "^EKE-REG-[0-9]{4}-[0-9]{3}$"
    },
    "audit_reference": {
      "type": "string",
      "pattern": "^EKE-AUDIT-[0-9]{4}-[0-9]{3}$"
    },
    "evidence_root": {
      "type": "string",
      "minLength": 1
    },
    "blockchain_anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "string",
          "minLength": 1
        },
        "transaction_reference": {
          "type": "string",
          "minLength": 1
        },
        "block_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "token_id": {
          "type": "string",
          "minLength": 1
        },
        "contract_reference": {
          "type": "string",
          "minLength": 1
        },
        "chain_reference": {
          "type": "string",
          "minLength": 1
        },
        "metadata_uri": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

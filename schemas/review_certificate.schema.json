{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/eke/review_certificate.schema.json",
  "title": "EKE Review Certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificate_id",
    "review_id",
    "status",
    "issuance",
    "certificate_type",
    "review_outcome",
    "classification"
  ],
  "properties": {
    "certificate_id": {
      "type": "string",
      "pattern": "^EKE-CERT-[0-9]{4}-[0-9]{3}$"
    },
    "review_id": {
      "type": "string",
      "pattern": "^EKE-IR-[0-9]{4}-[0-9]{3}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "REVOKED",
        "CHALLENGED"
      ]
    },
    "issuance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "issuer_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification_state": {
      "type": "string",
      "enum": [
        "DESIGNED",
        "IMPLEMENTED",
        "TESTED",
        "VERIFIED",
        "INDEPENDENTLY_REPRODUCED"
      ]
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EKE-EV-[0-9]{4}-[0-9]{3}$"
      }
    },
    "reviewer_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_reference",
        "attestation_statement",
        "attestation_timestamp"
      ],
      "properties": {
        "reviewer_reference": {
          "type": "string",
          "minLength": 1
        },
        "attestation_statement": {
          "type": "string",
          "minLength": 1
        },
        "attestation_timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      }
    },
    "ai_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used"
      ],
      "properties": {
        "used": {
          "type": "boolean"
        },
        "system_provider": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "decision_authority": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hash": {
          "type": "string",
          "minLength": 1
        },
        "manifest_reference": {
          "type": "string",
          "minLength": 1
        },
        "cryptographic_root": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "challenge_reference": {
      "type": "string",
      "pattern": "^EKE-(DSP|APL)-[0-9]{4}-[0-9]{3}$"
    },
    "certificate_type": {
      "type": "string",
      "enum": [
        "VERIFIABLE",
        "FAILED",
        "AI_ASSISTED"
      ]
    },
    "review_outcome": {
      "type": "string",
      "enum": [
        "SUCCESSFUL_REVIEW",
        "REVIEW_FAILED",
        "AI_ASSISTED_HUMAN_VERIFIED"
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "NON_CONFORMANT",
        "PARTIALLY_VERIFIED"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "VERY_HIGH"
      ]
    },
    "babt_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "contract_address",
        "token_id",
        "token_standard",
        "holding_address"
      ],
      "properties": {
        "network": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "BNB Smart Chain"
          ]
        },
        "contract_address": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$",
          "examples": [
            "0x2B09d47D550061f995A3b5C6F0Fd58005215D7c8"
          ]
        },
        "token_id": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "examples": [
            "930387"
          ]
        },
        "token_standard": {
          "type": "string",
          "enum": [
            "BEP-721"
          ],
          "examples": [
            "BEP-721"
          ]
        },
        "holding_address": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$",
          "examples": [
            "0xf6F211bEEb7bbA594c4B0B93708fD709318F32Eb"
          ]
        },
        "creator_address": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$",
          "examples": [
            "0x9189739e7dc22c8933ccbe859129df1b57218848"
          ]
        },
        "mint_transaction": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{64}$",
          "examples": [
            "0x1ba835759e5ebc4832a64ddbbb5cfbfefaf54f025f64329a297df651d1b01fb5"
          ]
        },
        "mint_block": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "examples": [
            "34120391"
          ]
        }
      }
    },
    "registry_reference": {
      "type": "string",
      "pattern": "^EKE-REG-[0-9]{4}-[0-9]{3}$"
    },
    "audit_reference": {
      "type": "string",
      "pattern": "^EKE-AUDIT-[0-9]{4}-[0-9]{3}$"
    },
    "evidence_root": {
      "type": "string",
      "minLength": 1
    },
    "blockchain_anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "string",
          "minLength": 1
        },
        "transaction_reference": {
          "type": "string",
          "minLength": 1
        },
        "block_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "token_id": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "examples": [
            "930387"
          ]
        },
        "contract_reference": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$",
          "examples": [
            "0x2B09d47D550061f995A3b5C6F0Fd58005215D7c8"
          ]
        },
        "chain_reference": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "BNB Smart Chain"
          ]
        },
        "metadata_uri": {
          "type": "string",
          "minLength": 1
        },
        "token_standard": {
          "type": "string",
          "enum": [
            "BEP-721"
          ],
          "examples": [
            "BEP-721"
          ]
        },
        "holding_address": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$",
          "examples": [
            "0xf6F211bEEb7bbA594c4B0B93708fD709318F32Eb"
          ]
        }
      }
    }
  }
}

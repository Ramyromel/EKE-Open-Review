{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/eke/review_registry.schema.json",
  "title": "EKE Review Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "object",
    "state"
  ],
  "properties": {
    "registry_id": {
      "type": "string",
      "pattern": "^EKE-REG-[0-9]{4}-[0-9]{3}$"
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "REVIEW_APPLICATION",
            "ACTIVE_REVIEW",
            "COMPLETED_REVIEW",
            "REVIEW_CERTIFICATE",
            "EVIDENCE_PACKAGE",
            "CHALLENGE",
            "APPEAL",
            "AUDIT_RECORD"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "REVOKED",
        "CHALLENGED"
      ]
    },
    "review_id": {
      "type": "string",
      "pattern": "^EKE-IR-[0-9]{4}-[0-9]{3}$"
    },
    "previous_registry_id": {
      "type": "string",
      "pattern": "^EKE-REG-[0-9]{4}-[0-9]{3}$"
    },
    "effective_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "state_change_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "evidence_reference": {
      "type": "string",
      "minLength": 1
    },
    "certificate_id": {
      "type": "string",
      "pattern": "^EKE-CERT-[0-9]{4}-[0-9]{3}$"
    },
    "challenge_reference": {
      "type": "string",
      "minLength": 1
    },
    "revocation_reference": {
      "type": "string",
      "minLength": 1
    }
  }
}

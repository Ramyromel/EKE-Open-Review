{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/eke/independent_verification.schema.json",
  "title": "EKE Independent Verification Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_id",
    "review_id",
    "status",
    "outcome",
    "subject",
    "criteria",
    "evidence_references",
    "procedure",
    "independence",
    "reproduction",
    "multi_implementation",
    "determination"
  ],
  "properties": {
    "verification_id": {
      "type": "string",
      "pattern": "^EKE-IV-[0-9]{4}-[0-9]{3}$"
    },
    "review_id": {
      "type": "string",
      "pattern": "^EKE-IR-[0-9]{4}-[0-9]{3}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "DESIGNED",
        "EXECUTED",
        "DETERMINED",
        "CHALLENGED",
        "REVOKED"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "PASS",
        "PARTIAL",
        "FAIL",
        "NOT_DETERMINED"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "description"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "verifier_reference"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NOT_APPLICABLE",
            "DECLARED",
            "SATISFIED",
            "FAILED"
          ]
        },
        "verifier_reference": {
          "type": "string",
          "minLength": 1
        },
        "conflict_of_interest": {
          "type": "string",
          "enum": [
            "NONE_DECLARED",
            "DECLARED",
            "UNDER_REVIEW"
          ]
        }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NOT_APPLICABLE",
            "NOT_PERFORMED",
            "REPRODUCED",
            "FAILED"
          ]
        },
        "artifact_reference": {
          "type": "string",
          "minLength": 1
        },
        "result_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "multi_implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NOT_APPLICABLE",
            "NOT_PERFORMED",
            "SATISFIED",
            "FAILED"
          ]
        },
        "implementation_references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "comparison_result": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "determination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "timestamp"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ai_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used"
      ],
      "properties": {
        "used": {
          "type": "boolean"
        },
        "system_provider": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "decision_authority": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

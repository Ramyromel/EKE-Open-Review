{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/eke/review_scope.schema.json",
  "title": "EKE Review Scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "subject",
    "scope",
    "evidence_boundary",
    "review_level"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "pattern": "^EKE-IR-[0-9]{4}-[0-9]{3}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "out_of_scope"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared"
      ],
      "properties": {
        "declared": {
          "type": "boolean"
        }
      }
    },
    "review_level": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    }
  }
}

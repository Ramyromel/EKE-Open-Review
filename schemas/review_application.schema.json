{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/eke/review_application.schema.json",
  "title": "EKE Review Application",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_id",
    "status",
    "subject",
    "requested_scope",
    "requested_review_level"
  ],
  "properties": {
    "application_id": {
      "type": "string",
      "pattern": "^EKE-RA-[0-9]{4}-[0-9]{3}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "SUBMITTED",
        "SCREENING",
        "ACCEPTED",
        "REJECTED",
        "WITHDRAWN",
        "CONVERTED_TO_REVIEW"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requested_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "out_of_scope"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requested_review_level": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    }
  }
}
